# SQLite file database — self-contained, no external service required.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (auto-generated fallback is used in dev if unset).
# Generate your own with: openssl rand -base64 32
AUTH_SECRET="change-this-in-production-please-use-a-random-32-byte-string"

# Optional: enables the real AI Intent Check path via Anthropic's API.
# If unset, VIVEK/Aegis automatically uses its deterministic pattern-matching
# fallback classifier — the app is fully demoable without this key.
ANTHROPIC_API_KEY=
