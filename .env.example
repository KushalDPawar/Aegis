# SQLite file database — self-contained, no external service required.
# Local default (path is relative to the prisma/ folder):
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies.
# REQUIRED in production. Generate with: openssl rand -base64 32
# On Vercel: Project → Settings → Environment Variables → AUTH_SECRET
AUTH_SECRET="change-this-in-production-please-use-a-random-32-byte-string"

# Optional: enables the real AI Intent Check path via Anthropic's API.
# If unset, Aegis uses its deterministic pattern-matching fallback — fully demoable without this key.
ANTHROPIC_API_KEY=
